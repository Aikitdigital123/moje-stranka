{
  "name": "moje-stranka",
  "private": true,
  "type": "module",
  "description": "AIKIT Digital – Divize Industry 4.0 (static pages) + CCAR-F Trainer (Vite app in ccar-f/)",
  "scripts": {
    "dev": "vite ccar-f",
    "build": "vite build ccar-f && node scripts/assemble.mjs",
